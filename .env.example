# Copy to .env and fill in. Public keys only - never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Routing / distance / route-optimisation (OpenRouteService, free key, no card).
# Only needed once the trip/route feature lands - the crew stop map (Leaflet +
# OpenStreetMap) needs no key.
VITE_ORS_API_KEY=
