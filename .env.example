# Copy to .env and fill in. Public keys only - never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Maps JavaScript API - browser key (restrict by HTTP referrer + to the
# "Maps JavaScript API"). Used only for the crew stop map. If blank, the map area
# shows a placeholder and coordinate entry still works.
VITE_GOOGLE_MAPS_API_KEY=
